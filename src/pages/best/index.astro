---
import Base from '../../layouts/Base.astro';
---
<Base title="Best Picks — PickNotch" description="PickNotch best-of lists and buying guides. Our top recommendations across active categories." noindex={true}>

  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Shortlists</p>
      <h1>Best Picks</h1>
      <p class="page-sub">Our top recommendations in each category — best overall, best budget, and best for specific needs.</p>
    </div>
  </section>

  <section class="best-section">
    <div class="wrap">
      <div class="best-active">
        <h2 class="section-h2">E-bikes</h2>
        <div class="best-grid">
          {[
            { title: 'Best budget e-bikes',        desc: 'The best e-bikes under $800. Where to find real value and what corners get cut.', status: 'Coming soon' },
            { title: 'Best fat tyre e-bikes',      desc: 'The most capable fat-tyre e-bikes compared. Stability, range, and value.', status: 'Coming soon' },
            { title: 'Best commuter e-bikes',      desc: 'Daily riders. We compare range honesty, motor type, and long-term support.', status: 'Coming soon' },
            { title: 'Best folding e-bikes',       desc: 'Portable e-bikes that actually fold without compromising too much.', status: 'Coming soon' },
          ].map(({ title, desc, status }) => (
            <div class="best-card">
              <div class="best-card-top">
                <span class="best-label">Best picks</span>
                <span class="soon-pill">{status}</span>
              </div>
              <h3 class="best-title">{title}</h3>
              <p class="best-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="best-coming">
        <h2 class="section-h2">Coming soon</h2>
        <div class="coming-grid">
          {['Best tech gadgets', 'Best home appliances', 'Best outdoor gear', 'Best power tools'].map(t => (
            <div class="coming-card">
              <span class="coming-dot">○</span>
              <span>{t}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
.page-hero { background: var(--ink); padding: 52px 0 48px; }
.page-hero .eyebrow { font-family: 'Sora', sans-serif; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cyan); margin: 0 0 8px; }
.page-hero h1 { font-size: clamp(28px, 4vw, 40px); font-weight: 800; color: #fff; margin: 0 0 10px; }
.page-sub { font-size: 16px; color: #7A90B0; margin: 0; line-height: 1.65; }
.best-section { padding: 52px 0 80px; }
.section-h2 { font-size: clamp(18px, 2.5vw, 24px); font-weight: 700; margin: 0 0 20px; color: var(--ink); }
.best-active { margin-bottom: 52px; padding-bottom: 52px; border-bottom: 1px solid var(--line); }
.best-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
.best-card { background: #fff; border: 1px solid var(--line); border-radius: 13px; padding: 20px 22px; }
.best-card-top { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
.best-label { font-family: 'Sora', sans-serif; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.soon-pill { font-family: 'Sora', sans-serif; font-size: 10px; font-weight: 600; background: var(--paper); color: var(--muted); padding: 2px 8px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid var(--line); }
.best-title { font-family: 'Sora', sans-serif; font-size: 16px; font-weight: 600; margin: 0 0 7px; color: var(--ink); }
.best-desc { font-size: 13px; color: var(--slate); margin: 0; line-height: 1.55; }
.coming-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.coming-card { display: flex; align-items: center; gap: 8px; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; font-size: 14px; color: var(--muted); font-family: 'Sora', sans-serif; font-weight: 500; }
.coming-dot { color: var(--line); font-size: 16px; }
</style>
