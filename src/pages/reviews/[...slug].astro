---
import Base from '../../layouts/Base.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import DisclosureBox from '../../components/DisclosureBox.astro';
import ProductImage from '../../components/ProductImage.astro';
import CustomerReviewCarousel from '../../components/CustomerReviewCarousel.astro';
import ProsConsTable from '../../components/ProsConsTable.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((r) => ({ params: { slug: r.slug }, props: { review: r } }));
}

const { review } = Astro.props;
const d = review.data;
const { Content } = await review.render();

const schema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": { "@type": "Product", "name": d.product, "brand": { "@type": "Brand", "name": d.brand } },
  "reviewRating": d.score != null ? { "@type": "Rating", "ratingValue": d.score, "bestRating": 10 } : undefined,
  "author": { "@type": "Organization", "name": "PickNotch" },
  "publisher": { "@type": "Organization", "name": "PickNotch" },
  "datePublished": d.updated,
};
---
<Base title={`${d.title} | PickNotch`} description={d.summary}>

  <div class="review-wrap">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/reviews">Reviews</a>
      <span aria-hidden="true">›</span>
      <a href="/categories/e-bikes">{d.category}</a>
      <span aria-hidden="true">›</span>
      <span>{d.brand}</span>
    </nav>

    <!-- Product image -->
    <div class="review-image-wrap" id="review-hero-image">
      <ProductImage
        src={d.image}
        alt={d.imageAlt ?? d.product}
        fallbackLabel={d.product}
        eager={true}
        class="review-pi"
      />
      {d.score != null && (
        <div class="review-image-badge">
          <span class="rib-num">{d.score.toFixed(1)}</span>
          <span class="rib-label">PickNotch Score</span>
        </div>
      )}
      <div class="review-image-chip">
        <span class="ric-cat">{d.category}</span>
        <span class="ric-sep">·</span>
        <span class="ric-brand">{d.brand}</span>
      </div>
    </div>

    <!-- Gallery strip -->
    {d.gallery && d.gallery.length > 0 && (
      <div class="gallery-strip" id="gallery-strip">
        {d.gallery.map((img, i) => (
          <button class:list={['gallery-thumb', i === 0 ? 'gallery-thumb--active' : '']}
            data-src={img.src} aria-label={img.alt} type="button">
            <ProductImage src={img.src} alt={img.alt} fallbackLabel={d.product} />
          </button>
        ))}
      </div>
    )}

    <!-- Review hero -->
    <div class="review-hero">
      <div class="review-hero-left">
        <div class="review-meta">
          {d.updated && <span class="meta-updated">Updated {d.updated}</span>}
        </div>
        <h1 class="review-title">{d.title}</h1>
        {d.bestFor && (
          <div class="review-bestfor">
            <span class="bf-label">Best for</span>
            <span class="bf-val">{d.bestFor}</span>
          </div>
        )}
        {d.avoidIf && (
          <div class="review-avoid">
            <span class="avoid-label">Avoid if</span>
            <span class="avoid-val">{d.avoidIf}</span>
          </div>
        )}
        <p class="review-disclosure-note">Independently researched · affiliate supported</p>
      </div>
      <div class="review-hero-right">
        <ScoreBadge score={d.score ?? null} size="lg" />
        {d.score != null && <span class="score-out">out of 10</span>}
      </div>
    </div>

    <!-- Summary + Deal row -->
    <div class="top-row">
      <div class="verdict-box">
        <div class="vb-label">The verdict</div>
        <p class="vb-text">{d.verdict ?? d.summary}</p>
      </div>
      {d.merchantUrl && (
        <div class="deal-box">
          <div class="deal-top-label">Best price today</div>
          {d.price && <div class="deal-price">{d.price} <span class="deal-at">at {d.brand}</span></div>}
          {d.code && (
            <div class="deal-code-row">
              <span class="deal-code-label">Code</span>
              <span class="deal-code">{d.code}</span>
            </div>
          )}
          <a class="deal-cta" href={d.merchantUrl} rel="nofollow sponsored" target="_blank">
            Check price →
          </a>
          <small class="deal-note">We may earn a commission. It never changes our score.</small>
        </div>
      )}
    </div>

    <!-- Pros / Cons table -->
    {(d.pros?.length || d.cons?.length) && (
      <ProsConsTable pros={d.pros} cons={d.cons} />
    )}

    <!-- Specs table -->
    {d.specs && Object.keys(d.specs).length > 0 && (
      <div class="specs-section">
        <h2 class="specs-heading">Specs</h2>
        <table class="specs-table">
          <tbody>
            {Object.entries(d.specs).map(([key, val]) => (
              <tr>
                <th>{key}</th>
                <td>{val}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Full review content -->
    <article class="review-content">
      <Content />
    </article>

  </div>

  <!-- Customer reviews carousel (full width) -->
  {d.customerReviews && d.customerReviews.length > 0 && (
    <section class="owners-section">
      <div class="owners-head wrap-narrow">
        <span class="owners-eyebrow">Owner feedback</span>
        <h2 class="owners-heading">What owners are saying</h2>
        <p class="owners-sub">Short real-world notes from riders who bought the bike.</p>
      </div>
      <div class="owners-carousel-wrap">
        <CustomerReviewCarousel reviews={d.customerReviews} />
      </div>
    </section>
  )}

  <!-- Disclosure -->
  <div class="disclosure-wrap wrap-narrow">
    <DisclosureBox />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<script>
  const strip = document.getElementById('gallery-strip');
  if (strip) {
    const heroWrap = document.getElementById('review-hero-image');
    const heroImg = heroWrap?.querySelector('.pi-img') as HTMLImageElement | null;

    strip.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.src;
        if (!src || !heroImg) return;
        heroImg.src = src;
        heroImg.classList.remove('pi-broken');
        strip.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('gallery-thumb--active'));
        thumb.classList.add('gallery-thumb--active');
      });
    });
  }
</script>

<style>
.review-wrap {
  max-width: 760px;
  margin: 0 auto;
  padding: 32px 24px 56px;
}

/* Breadcrumb */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 24px;
  flex-wrap: wrap;
}
.breadcrumb a {
  color: var(--slate);
  text-decoration: none;
  transition: color 0.13s ease;
}
.breadcrumb a:hover { color: var(--cyan); }
.breadcrumb span[aria-hidden] { color: var(--line); }

/* Product image */
.review-image-wrap {
  position: relative;
  width: 100%;
  height: 360px;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 10px;
  background: var(--ink-deep);
}
.review-pi { border-radius: 20px; }

.review-image-badge {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: rgba(13,21,48,0.84);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(34,211,238,0.22);
  border-radius: 14px;
  padding: 10px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.rib-num {
  font-family: 'Sora', sans-serif;
  font-size: 26px;
  font-weight: 800;
  color: #22D3EE;
  letter-spacing: -0.05em;
  line-height: 1;
}
.rib-label {
  font-family: 'Sora', sans-serif;
  font-size: 8px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.38);
  white-space: nowrap;
}

.review-image-chip {
  position: absolute;
  top: 16px;
  left: 16px;
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(13,21,48,0.78);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 99px;
  padding: 5px 13px;
}
.ric-cat {
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #22D3EE;
}
.ric-sep { font-size: 12px; color: rgba(255,255,255,0.2); }
.ric-brand { font-size: 11px; color: rgba(255,255,255,0.55); font-weight: 500; }

/* Gallery */
.gallery-strip {
  display: flex;
  gap: 8px;
  margin-bottom: 32px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding: 2px;
}
.gallery-strip::-webkit-scrollbar { display: none; }
.gallery-thumb {
  flex-shrink: 0;
  width: 80px;
  height: 60px;
  border-radius: 10px;
  overflow: hidden;
  border: 2px solid var(--line);
  background: var(--ink-deep);
  position: relative;
  padding: 0;
  cursor: pointer;
  transition: border-color 0.15s ease, transform 0.15s var(--ease-spring);
}
.gallery-thumb:hover { border-color: rgba(34,211,238,0.45); transform: translateY(-1px); }
.gallery-thumb:active { transform: translateY(0); }
.gallery-thumb:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
.gallery-thumb--active { border-color: var(--cyan); }

/* Review hero */
.review-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
  margin-top: 8px;
}
.review-hero-left { flex: 1; min-width: 0; }
.review-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}
.meta-updated { font-size: 12px; color: var(--muted); }
.review-title {
  font-size: clamp(20px, 3vw, 28px);
  font-weight: 700;
  margin: 0 0 14px;
  line-height: 1.2;
  color: var(--ink);
}
.review-bestfor, .review-avoid {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 14px;
  margin-bottom: 7px;
}
.bf-label, .avoid-label {
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding-top: 2px;
  white-space: nowrap;
  flex-shrink: 0;
}
.bf-label { color: #0E7490; }
.avoid-label { color: #92400E; }
.bf-val { font-size: 14px; color: var(--ink); font-weight: 500; line-height: 1.45; }
.avoid-val { font-size: 14px; color: var(--slate); line-height: 1.45; }
.review-disclosure-note {
  font-size: 11px;
  color: var(--muted);
  font-family: 'Sora', sans-serif;
  margin: 12px 0 0;
}
.review-hero-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  padding-top: 4px;
}
.score-out {
  font-size: 11px;
  color: var(--muted);
  font-family: 'Sora', sans-serif;
}

/* Top row */
.top-row {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}
.verdict-box {
  flex: 1.5;
  min-width: 240px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 13px;
  padding: 18px 20px;
}
.vb-label {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--muted);
  margin-bottom: 8px;
}
.vb-text { font-size: 15px; color: #334155; margin: 0; line-height: 1.65; }

.deal-box {
  flex: 1;
  min-width: 200px;
  background: var(--ink);
  color: #C8D8E8;
  border-radius: 13px;
  padding: 18px 20px;
}
.deal-top-label { font-size: 11px; font-family: 'Sora', sans-serif; color: #7A90B0; margin-bottom: 6px; }
.deal-price { font-family: 'Sora', sans-serif; font-size: 24px; font-weight: 700; color: #fff; margin-bottom: 10px; }
.deal-at { font-size: 12px; color: #7A90B0; font-weight: 400; }
.deal-code-row { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
.deal-code-label { font-size: 11px; font-family: 'Sora', sans-serif; color: #7A90B0; text-transform: uppercase; letter-spacing: 0.06em; }
.deal-code {
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--cyan);
  border: 1px dashed rgba(34,211,238,0.4);
  padding: 3px 10px;
  border-radius: 6px;
  letter-spacing: 0.06em;
}
.deal-cta {
  display: block;
  text-align: center;
  background: var(--cyan);
  color: #0C1F30;
  font-family: 'Sora', sans-serif;
  font-size: 14px;
  font-weight: 700;
  padding: 11px;
  border-radius: 8px;
  text-decoration: none;
  margin-bottom: 8px;
  transition: opacity 0.13s ease;
}
.deal-cta:hover { opacity: 0.88; }
.deal-cta:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 8px; }
.deal-note { font-size: 11px; color: #5A6E8E; display: block; line-height: 1.5; }

/* Specs */
.specs-section { margin-bottom: 32px; }
.specs-heading { font-size: 18px; font-weight: 700; margin: 0 0 12px; color: var(--ink); }
.specs-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.specs-table th {
  text-align: left;
  padding: 9px 12px;
  font-weight: 600;
  color: var(--slate);
  background: var(--paper);
  border: 1px solid var(--line);
  width: 35%;
  font-family: 'Sora', sans-serif;
  font-size: 13px;
}
.specs-table td {
  padding: 9px 12px;
  color: #334155;
  border: 1px solid var(--line);
}

/* Review content */
.review-content {
  font-size: 16px;
  color: #334155;
  line-height: 1.75;
}
.review-content h2 {
  font-size: 20px;
  font-weight: 700;
  color: var(--ink);
  margin: 36px 0 12px;
  letter-spacing: -0.02em;
}
.review-content h3 {
  font-size: 17px;
  font-weight: 600;
  color: var(--ink);
  margin: 24px 0 10px;
}
.review-content p { margin: 0 0 16px; }
.review-content ul, .review-content ol {
  padding-left: 22px;
  margin: 0 0 16px;
}
.review-content li { margin-bottom: 6px; }
.review-content strong { color: var(--ink); font-weight: 600; }
.review-content table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  margin: 0 0 20px;
}
.review-content th, .review-content td {
  padding: 8px 12px;
  border: 1px solid var(--line);
  text-align: left;
}
.review-content th {
  background: var(--paper);
  font-family: 'Sora', sans-serif;
  font-size: 12px;
  font-weight: 600;
  color: var(--slate);
}

/* Owners section */
.owners-section {
  background: var(--paper);
  padding: 72px 0 80px;
}
.owners-head {
  text-align: center;
  margin-bottom: 44px;
}
.owners-eyebrow {
  display: inline-block;
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--cyan);
  margin-bottom: 10px;
}
.owners-heading {
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700;
  color: var(--ink);
  margin: 0 0 10px;
  letter-spacing: -0.03em;
}
.owners-sub {
  font-size: 15px;
  color: var(--slate);
  line-height: 1.65;
  margin: 0;
}
.owners-carousel-wrap { padding: 0 40px; }

/* Disclosure */
.disclosure-wrap { padding: 40px 28px 64px; }

@media (max-width: 640px) {
  .review-wrap { padding: 20px 16px 40px; }
  .review-image-wrap { height: 240px; }
  .review-hero { flex-direction: column-reverse; gap: 12px; margin-top: 4px; }
  .top-row { flex-direction: column; }
  .owners-carousel-wrap { padding: 0 16px; }
  .review-image-badge { padding: 8px 12px; }
  .rib-num { font-size: 20px; }
}
</style>
