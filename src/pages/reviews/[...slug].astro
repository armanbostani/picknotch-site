---
import Base from '../../layouts/Base.astro';
import DisclosureBox from '../../components/DisclosureBox.astro';
import CustomerReviewCarousel from '../../components/CustomerReviewCarousel.astro';
import ProsConsTable from '../../components/ProsConsTable.astro';
import ReviewHero from '../../components/ReviewHero.astro';
import ReviewScoreBreakdown from '../../components/ReviewScoreBreakdown.astro';
import ReviewFeatureBlock from '../../components/ReviewFeatureBlock.astro';
import FinalVerdictCTA from '../../components/FinalVerdictCTA.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((r) => ({ params: { slug: r.slug }, props: { review: r } }));
}

const { review } = Astro.props;
const d = review.data;
const { Content } = await review.render();

const gallery = d.gallery && d.gallery.length > 0
  ? d.gallery
  : (d.image ? [{ src: d.image, alt: d.imageAlt ?? d.product }] : []);

const features = d.features ?? [];
const verdictHeadline = d.verdictHeadline ?? `Our verdict on the ${d.product}`;
const verdictSub = d.verdictSub ?? d.verdict ?? d.summary;

const schema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": { "@type": "Product", "name": d.product, "brand": { "@type": "Brand", "name": d.brand } },
  "reviewRating": d.score != null ? { "@type": "Rating", "ratingValue": d.score, "bestRating": 10 } : undefined,
  "author": { "@type": "Organization", "name": "PickNotch" },
  "publisher": { "@type": "Organization", "name": "PickNotch" },
  "datePublished": d.updated,
};
---
<Base title={`${d.title} | PickNotch`} description={d.summary}>

  <!-- 1. Product hero: gallery + purchase panel -->
  <ReviewHero
    title={d.title}
    brand={d.brand}
    category={d.category}
    score={d.score}
    verdict={d.verdict ?? d.summary}
    bestFor={d.bestFor}
    avoidIf={d.avoidIf}
    price={d.price}
    code={d.code}
    discount={d.discount}
    merchantUrl={d.merchantUrl}
    updated={d.updated}
    images={gallery}
  />

  <!-- 2. Score breakdown -->
  {d.score != null && d.scores && d.scores.length > 0 && (
    <section class="rv-section">
      <div class="wrap-wide">
        <div class="rv-head">
          <span class="eyebrow">How it scores</span>
          <h2 class="rv-h2">The verdict, by the numbers</h2>
        </div>
        <div class="rv-intro"><Content /></div>
        <ReviewScoreBreakdown
          score={d.score}
          scores={d.scores}
          lead={d.scoreLead}
        />
      </div>
    </section>
  )}

  <!-- 3. Pros / cons -->
  {(d.pros?.length || d.cons?.length) && (
    <section class="rv-section rv-section--paper">
      <div class="wrap-wide">
        <div class="rv-head">
          <span class="eyebrow">The balance</span>
          <h2 class="rv-h2">What works, what to watch</h2>
        </div>
        <ProsConsTable pros={d.pros} cons={d.cons} />
      </div>
    </section>
  )}

  <!-- 4. Image-led feature story -->
  {features.length > 0 && (
    <section class="rv-section">
      <div class="wrap-wide">
        <div class="rv-head">
          <span class="eyebrow">Why it earns 8.5</span>
          <h2 class="rv-h2">Built around the everyday ride</h2>
        </div>
        <div class="rv-features">
          {features.map((f, i) => (
            <ReviewFeatureBlock
              title={f.title}
              body={f.body}
              image={f.image}
              imageAlt={f.imageAlt}
              index={i}
              reverse={i % 2 === 1}
            />
          ))}
        </div>

        <!-- The catch callout -->
        <div class="catch">
          <div class="catch-stat">
            <span class="catch-num">61</span>
            <span class="catch-unit">lb</span>
          </div>
          <div class="catch-text">
            <span class="catch-eyebrow">The catch</span>
            <p class="catch-body">The comfort hardware is also the compromise. This is a bike you ride from ground-level storage — not one you want to carry upstairs every day.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 5. Owner reviews -->
  {d.customerReviews && d.customerReviews.length > 0 && (
    <section class="rv-section rv-section--paper owners">
      <div class="rv-head wrap-wide">
        <span class="eyebrow">Owner feedback</span>
        <h2 class="rv-h2">What 150,000+ riders report</h2>
      </div>
      <div class="owners-rail">
        <CustomerReviewCarousel reviews={d.customerReviews} />
      </div>
    </section>
  )}

  <!-- 6. Specs (lower priority, collapsible) -->
  {d.specs && Object.keys(d.specs).length > 0 && (
    <section class="rv-section rv-section--slim">
      <div class="wrap">
        <details class="specs-acc">
          <summary class="specs-summary">
            <span class="specs-summary-label">Full specifications</span>
            <span class="specs-summary-meta">{Object.keys(d.specs).length} details</span>
            <svg class="specs-chev" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M5 7l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <dl class="specs-grid">
            {Object.entries(d.specs).map(([key, val]) => (
              <div class="spec-row">
                <dt>{key}</dt>
                <dd>{val}</dd>
              </div>
            ))}
          </dl>
        </details>
      </div>
    </section>
  )}

  <!-- 7. Final verdict CTA -->
  <FinalVerdictCTA
    score={d.score}
    headline={verdictHeadline}
    sub={verdictSub}
    price={d.price}
    code={d.code}
    discount={d.discount}
    merchantUrl={d.merchantUrl}
    brand={d.brand}
    image={d.verdictImage}
    imageAlt={d.verdictImageAlt}
  />

  <!-- Disclosure -->
  <div class="disclosure-wrap wrap-narrow">
    <DisclosureBox />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<style>
.rv-section { padding: 64px 0; }
.rv-section--slim { padding: 40px 0; }
.rv-section--paper { background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

.rv-head { margin-bottom: 32px; }
.rv-h2 {
  font-size: clamp(24px, 3vw, 34px);
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--ink);
  line-height: 1.1;
}

.rv-intro {
  max-width: 720px;
  margin-bottom: 30px;
}
.rv-intro :global(p) {
  font-size: 17px;
  line-height: 1.7;
  color: var(--slate);
  margin: 0;
}

.rv-features {
  display: flex;
  flex-direction: column;
  gap: 64px;
}

/* The catch callout */
.catch {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 56px;
  padding: 28px 32px;
  background: linear-gradient(135deg, #16223F 0%, #0D1530 100%);
  border: 1px solid rgba(217,119,6,0.28);
  border-radius: 20px;
  box-shadow: 0 20px 48px rgba(8,16,40,0.26);
}
.catch-stat {
  display: flex;
  align-items: baseline;
  gap: 3px;
  flex-shrink: 0;
  padding-right: 28px;
  border-right: 1px solid rgba(255,255,255,0.12);
}
.catch-num {
  font-family: 'Sora', sans-serif;
  font-size: 64px;
  font-weight: 800;
  letter-spacing: -0.05em;
  line-height: 1;
  background: linear-gradient(120deg, #FBBF24, #F59E0B);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.catch-unit { font-family: 'Sora', sans-serif; font-size: 22px; font-weight: 700; color: rgba(255,255,255,0.5); }
.catch-eyebrow {
  display: inline-block;
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #FBBF24;
  margin-bottom: 6px;
}
.catch-body { font-size: 15.5px; line-height: 1.6; color: rgba(255,255,255,0.78); margin: 0; max-width: 60ch; }

/* Owners */
.owners .rv-head { text-align: center; }
.owners-rail { padding: 0 12px; }

/* Specs accordion */
.specs-acc {
  border: 1px solid var(--line);
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}
.specs-summary {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px 22px;
  cursor: pointer;
  list-style: none;
  user-select: none;
  transition: background 0.14s ease;
}
.specs-summary::-webkit-details-marker { display: none; }
.specs-summary:hover { background: var(--paper); }
.specs-summary:focus-visible { outline: 2px solid var(--cyan); outline-offset: -2px; border-radius: 16px; }
.specs-summary-label {
  font-family: 'Sora', sans-serif;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
}
.specs-summary-meta { font-size: 12px; color: var(--muted); }
.specs-chev {
  margin-left: auto;
  color: var(--slate);
  transition: transform 0.2s var(--ease-spring);
}
.specs-acc[open] .specs-chev { transform: rotate(180deg); }

.specs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 36px;
  padding: 6px 22px 22px;
  border-top: 1px solid var(--line);
}
.spec-row {
  display: grid;
  grid-template-columns: minmax(108px, 44%) 1fr;
  gap: 14px;
  align-items: baseline;
  padding: 11px 2px;
  border-bottom: 1px solid var(--line);
}
.spec-row dt { font-family: 'Sora', sans-serif; font-size: 12.5px; font-weight: 600; color: var(--slate); }
.spec-row dd { margin: 0; font-size: 13.5px; color: var(--ink); line-height: 1.4; }

.disclosure-wrap { padding: 48px 28px 72px; }

@media (max-width: 760px) {
  .rv-section { padding: 48px 0; }
  .rv-features { gap: 44px; }
  .catch { flex-direction: column; align-items: flex-start; gap: 16px; padding: 24px; margin-top: 40px; }
  .catch-stat { padding-right: 0; padding-bottom: 14px; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.12); width: 100%; }
  .specs-grid { grid-template-columns: 1fr; column-gap: 0; }
}
</style>
