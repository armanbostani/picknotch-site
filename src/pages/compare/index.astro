---
import Base from '../../layouts/Base.astro';
---
<Base title="Compare — PickNotch" description="Side-by-side product comparisons. See exactly where each product wins and loses before you buy.">

  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Side by side</p>
      <h1>Compare before you buy</h1>
      <p class="page-sub">Side-by-side comparisons so you can see exactly where each product wins and loses — not just which one "wins overall".</p>
    </div>
  </section>

  <section class="compare-section">
    <div class="wrap">
      <h2 class="section-h2">E-bike comparisons</h2>
      <div class="compare-grid">
        {[
          { a: 'TST R002', b: 'HappyRun G70', desc: 'Two budget moped-style e-bikes. Value vs utility, brake spec, passenger room, and real-world range.', status: 'Coming soon' },
          { a: 'Budget e-bikes',  b: 'Premium e-bikes', desc: "Is spending 3× more worth it? We break down what you actually gain — and where the budget option holds up.", status: 'Coming soon' },
          { a: 'Fat tyre',        b: 'Commuter', desc: 'Different designs for different riders. Trade-offs in weight, handling, range, and everyday usability.', status: 'Coming soon' },
        ].map(({ a, b, desc, status }) => (
          <div class="compare-card">
            <div class="compare-products">
              <span class="compare-product">{a}</span>
              <span class="compare-vs">VS</span>
              <span class="compare-product">{b}</span>
            </div>
            <p class="compare-desc">{desc}</p>
            <span class="soon-pill">{status}</span>
          </div>
        ))}
      </div>

      <div class="compare-what">
        <h2 class="section-h2" style="margin-top: 52px;">What each comparison includes</h2>
        <div class="what-grid">
          {[
            'Clear winner summary',
            'Side-by-side score cards',
            'Specs comparison table',
            'Best for X / best for Y',
            'Where each product wins',
            'Where each product loses',
            'Final recommendation',
            'Affiliate links for each',
          ].map(item => (
            <div class="what-item">
              <span class="what-check">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="suggest-box">
        <h3>Suggest a comparison</h3>
        <p>Want two products compared head to head? <a href="/contact">Tell us →</a></p>
      </div>

    </div>
  </section>

</Base>

<style>
.page-hero { background: var(--ink); padding: 52px 0 48px; }
.page-hero .eyebrow { font-family: 'Sora', sans-serif; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cyan); margin: 0 0 8px; }
.page-hero h1 { font-size: clamp(28px, 4vw, 40px); font-weight: 800; color: #fff; margin: 0 0 10px; }
.page-sub { font-size: 16px; color: #7A90B0; margin: 0; max-width: 520px; line-height: 1.65; }
.compare-section { padding: 52px 0 80px; }
.section-h2 { font-size: clamp(18px, 2.5vw, 24px); font-weight: 700; margin: 0 0 20px; color: var(--ink); }
.compare-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin-bottom: 8px; }
.compare-card { background: #fff; border: 1px solid var(--line); border-radius: 13px; padding: 22px; }
.compare-products { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
.compare-product { font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 600; color: var(--ink); }
.compare-vs { font-family: 'Sora', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; color: var(--cyan); background: rgba(34,211,238,0.1); padding: 3px 8px; border-radius: 20px; }
.compare-desc { font-size: 13px; color: var(--slate); margin: 0 0 13px; line-height: 1.55; }
.soon-pill { display: inline-block; font-size: 10px; font-weight: 600; font-family: 'Sora', sans-serif; background: var(--paper); color: var(--muted); padding: 2px 8px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid var(--line); }
.what-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.what-item { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--slate); padding: 10px 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; }
.what-check { color: #0D9488; font-weight: 700; flex-shrink: 0; }
.suggest-box { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 22px 24px; margin-top: 32px; }
.suggest-box h3 { font-family: 'Sora', sans-serif; font-size: 16px; font-weight: 600; margin: 0 0 6px; color: var(--ink); }
.suggest-box p { font-size: 15px; color: var(--slate); margin: 0; }
.suggest-box a { color: var(--cyan); font-weight: 500; text-decoration: none; }
.suggest-box a:hover { opacity: 0.75; }
</style>
