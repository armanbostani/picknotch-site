---
import Base from '../layouts/Base.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import PlaceholderVisual from '../components/PlaceholderVisual.astro';
import HeroVisual from '../components/HeroVisual.astro';
import MethodologyPreview from '../components/MethodologyPreview.astro';
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const published = allReviews
  .filter(r => r.data.status === 'published' && r.data.score != null)
  .sort((a, b) => {
    // Velotric Discover 3 is our first featured review — pin it first
    if (a.slug === 'velotric-discover-3') return -1;
    if (b.slug === 'velotric-discover-3') return 1;
    return (b.data.score ?? 0) - (a.data.score ?? 0);
  });

// Sort published reviews into ride-type lanes for the E-bikes focus section
function scoreColor(s: number | null | undefined) {
  if (s == null) return '#94A3B8';
  if (s >= 8.5) return '#0D9488';
  if (s >= 7.0) return '#0891B2';
  if (s >= 5.5) return '#D97706';
  return '#DC2626';
}

const ebikeTypes = [
  { type: 'Commuter & city',      desc: 'Daily riders judged on range honesty, comfort and long-term support.' },
  { type: 'Fat tyre & adventure', desc: 'Full-suspension, fat-tyre bikes for trail, sand and snow — capability vs weight.' },
  { type: 'Mountain & trekking',  desc: 'Geared 29ers for rough roads and light trails — value vs brand confidence.' },
  { type: 'Folding',              desc: 'Bikes that fold into a boot or cupboard — portability vs weight and wheel size.' },
  { type: 'Cargo',                desc: 'Long-tails built to carry kids, shopping and gear, and replace short car trips.' },
  { type: 'Moped & cargo',        desc: 'Throttle-first haulers with passenger room and real all-week range.' },
  { type: 'Off-road & dirt',      desc: 'E-motos and dirt bikes — big power, real suspension, the support gamble.' },
];
const ebikeGroups = ebikeTypes
  .map(g => ({ ...g, items: published.filter(r => r.data.type === g.type) }))
  .filter(g => g.items.length > 0);

const catchCards = [
  { title: 'Great specs. Weak support?',       body: 'High performance means nothing if the brand disappears after 6 months.' },
  { title: 'Low price. Hidden compromises?',   body: 'We find what corners got cut — and whether they matter for your use case.' },
  { title: 'Premium feel. Poor value?',        body: "Paying more doesn't always buy you more. We score value independently." },
];

const compareCards = [
  { a: 'Velotric', b: 'Rad Power',       desc: 'Two comfort commuters at different price points. Where the extra money actually goes.' },
  { a: 'Budget',   b: 'Premium',          desc: "Is it worth spending 3× more? We break down what you actually gain." },
  { a: 'Fat tyre', b: 'Commuter',         desc: 'Different use cases, different trade-offs. Which style suits your ride?' },
];
---

<Base
  title="PickNotch — Better picks. Fewer regrets."
  description="PickNotch compares the specs, trade-offs, and value behind products worth buying. Independent research. Clear verdicts. No hype."
>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="hero">
    <div class="hero-grid-layer" aria-hidden="true"></div>
    <div class="hero-glow-a" aria-hidden="true" data-parallax="0.18"></div>
    <div class="hero-glow-b" aria-hidden="true" data-parallax="0.10"></div>
    <div class="hero-glow-c" aria-hidden="true" data-parallax="0.26"></div>

    <div class="wrap">
      <div class="hero-inner">
        <div class="hero-left">
          <p class="hero-micro" data-reveal>Independent research · Clear verdicts · No hype-first rankings</p>
          <h1 class="hero-heading" data-reveal style="--reveal-delay: 80ms">Better picks.<br />Fewer regrets.</h1>
          <p class="hero-sub" data-reveal style="--reveal-delay: 170ms">PickNotch compares the specs, trade-offs, and value behind products worth buying.</p>
          <div class="hero-actions" data-reveal style="--reveal-delay: 260ms">
            <a href="/reviews" class="btn btn-primary shine">Browse reviews</a>
            <a href="/methodology" class="btn btn-ghost">How we pick</a>
          </div>
        </div>
        <div class="hero-right" data-reveal="zoom" style="--reveal-delay: 200ms">
          <HeroVisual />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ TRUST STRIP ═══════════════════════════ -->
  <TrustStrip />

  <!-- ═══════════════════════════ CATEGORIES ═══════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Explore</span>
        <h2 class="section-h2">Browse by category</h2>
        <p class="section-sub">Starting with e-bikes, then growing into every product category where specs, trade-offs, and support actually matter.</p>
      </div>
      <div class="cat-grid" data-reveal style="--reveal-delay: 90ms">
        <CategoryCard
          name="E-bikes"
          description="Budget commuters to fat-tyre models. We compare value, usability, and support confidence."
          status="active"
          iconName="ebike"
          href="/categories/e-bikes"
          tint="default"
        />
        <CategoryCard name="Tech & gadgets"      description="Phones, audio, laptops — where the spec sheet often lies."     status="coming-soon" iconName="tech"    tint="slate"  />
        <CategoryCard name="Home gear"           description="Appliances and kitchen tools worth researching before buying." status="coming-soon" iconName="home"    tint="warm"   />
        <CategoryCard name="Outdoor & mobility"  description="Scooters, camping gear, and outdoor equipment."               status="coming-soon" iconName="outdoor" tint="forest" />
        <CategoryCard name="Tools & equipment"   description="Power tools and workshop gear where quality matters."         status="coming-soon" iconName="tools"   tint="slate"  />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ E-BIKES FOCUS ═══════════════════════════ -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Current focus</span>
        <h2 class="section-h2">E-bikes, sorted by how you ride</h2>
        <p class="section-sub">Our first review library — grouped by ride type so you can jump straight to the bikes built for your kind of riding.</p>
      </div>

      <div class="ebcat-grid" data-reveal style="--reveal-delay: 80ms">
        {ebikeGroups.map(g => (
          <div class="ebcat-card">
            <div class="ebcat-head">
              <h3 class="ebcat-name">{g.type}</h3>
              <span class="ebcat-count">{g.items.length} {g.items.length === 1 ? 'review' : 'reviews'}</span>
            </div>
            <p class="ebcat-desc">{g.desc}</p>
            <div class="ebcat-list">
              {g.items.map(r => (
                <a href={`/reviews/${r.slug}`} class="ebcat-item">
                  <span class="ebcat-score" style={`--sc: ${scoreColor(r.data.score)}`}>{r.data.score?.toFixed(1)}</span>
                  <span class="ebcat-item-name">{r.data.brand} {r.data.product}</span>
                  <span class="ebcat-item-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="ebcat-cta" data-reveal>
        <a href="/categories/e-bikes" class="btn btn-outline">Explore all e-bikes →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ LATEST REVIEWS ═══════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Latest</span>
        <h2 class="section-h2">Latest picks</h2>
        <p class="section-sub">Published reviews alongside what we're currently researching.</p>
      </div>

      <div class="reviews-list" data-reveal style="--reveal-delay: 90ms">
        {published.map(r => (
          <ReviewCard
            title={r.data.title}
            brand={r.data.brand}
            score={r.data.score}
            bestFor={r.data.bestFor}
            summary={r.data.summary}
            slug={r.slug}
            category={r.data.category}
            status={r.data.status}
            image={r.data.image}
            imageAlt={r.data.imageAlt}
          />
        ))}

        <div class="ph-card">
          <div class="ph-thumb">
            <PlaceholderVisual label="E-bikes" />
          </div>
          <div class="ph-body">
            <div class="ph-meta">
              <span class="ph-category">E-bikes</span>
              <span class="ph-status">Researching</span>
            </div>
            <h3 class="ph-name">Urtopia Carbon One</h3>
            <p class="ph-focus">Early focus: lightweight design, smart features, price/value trade-off.</p>
          </div>
        </div>
      </div>

      <div class="list-cta" data-reveal>
        <a href="/reviews" class="btn btn-outline">Browse all reviews</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ METHODOLOGY ═══════════════════════════ -->
  <MethodologyPreview />

  <!-- ═══════════════════════════ THE CATCH ═══════════════════════════ -->
  <section class="catch-section">
    <div class="catch-glow-a" aria-hidden="true"></div>
    <div class="wrap">
      <div class="catch-head" data-reveal>
        <span class="eyebrow eyebrow--dark">Our philosophy</span>
        <h2 class="catch-heading">We always look for the catch.</h2>
        <p class="catch-sub">Specs sell the product. The catch tells you if you should actually buy it.</p>
      </div>
      <div class="catch-grid">
        {catchCards.map(({ title, body }) => (
          <div class="catch-card" data-reveal="zoom">
            <div class="catch-card-notch"></div>
            <h4 class="catch-card-title">{title}</h4>
            <p class="catch-card-body">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ COMPARE ═══════════════════════════ -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Compare</span>
        <h2 class="section-h2">Compare before you buy</h2>
        <p class="section-sub">Side-by-side comparisons so you can see exactly where each product wins and loses.</p>
      </div>
      <div class="compare-grid">
        {compareCards.map(({ a, b, desc }) => (
          <div class="cmp-card" data-reveal="zoom">
            <div class="cmp-vs-row">
              <span class="cmp-side">{a}</span>
              <span class="cmp-vs">VS</span>
              <span class="cmp-side">{b}</span>
            </div>
            <p class="cmp-desc">{desc}</p>
            <span class="cmp-soon">Coming soon</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ FINAL CTA ═══════════════════════════ -->
  <section class="cta-section">
    <div class="cta-glow-a" aria-hidden="true"></div>
    <div class="cta-glow-b" aria-hidden="true"></div>
    <div class="wrap">
      <div class="cta-inner" data-reveal>
        <h2 class="cta-heading">Don't buy blind.</h2>
        <p class="cta-sub">Start with clear picks, honest trade-offs, and fewer regrets.</p>
        <div class="cta-actions">
          <a href="/reviews" class="btn btn-primary shine">Browse reviews</a>
          <a href="/categories" class="btn btn-outline--light">Explore categories</a>
        </div>
        <p class="cta-disclosure">
          Affiliate supported — commissions never change our verdicts.
          <a href="/affiliate-disclosure" class="cta-disclosure-link">Read disclosure →</a>
        </p>
      </div>
    </div>
  </section>

</Base>

<style>
/* ─── Hero ─── */
.hero {
  background: var(--ink-deep);
  padding: 112px 0 124px;
  position: relative;
  overflow: hidden;
}
.hero-grid-layer {
  position: absolute;
  inset: -8% -4%;
  background-image: radial-gradient(rgba(92,230,247,0.16) 1px, transparent 1.4px);
  background-size: 28px 28px;
  -webkit-mask-image: radial-gradient(110% 90% at 72% 18%, black 0%, transparent 64%);
  mask-image: radial-gradient(110% 90% at 72% 18%, black 0%, transparent 64%);
  animation: grid-drift 26s linear infinite alternate;
  pointer-events: none;
}
@keyframes grid-drift {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-28px, -28px, 0); }
}
.hero-glow-a {
  position: absolute; top: -20%; right: -8%;
  width: 620px; height: 620px;
  background: radial-gradient(circle, rgba(34,211,238,0.10) 0%, transparent 66%);
  pointer-events: none;
  animation: glow-drift-a 18s ease-in-out infinite;
}
.hero-glow-b {
  position: absolute; bottom: -30%; left: 5%;
  width: 440px; height: 440px;
  background: radial-gradient(circle, rgba(34,211,238,0.05) 0%, transparent 68%);
  pointer-events: none;
  animation: glow-drift-b 24s ease-in-out infinite;
}
.hero-glow-c {
  position: absolute; top: 40%; left: 35%;
  width: 280px; height: 280px;
  background: radial-gradient(circle, rgba(34,211,238,0.04) 0%, transparent 70%);
  pointer-events: none;
  animation: glow-drift-a 21s ease-in-out infinite reverse;
}
@keyframes glow-drift-a {
  0%, 100% { translate: 0 0; }
  50%      { translate: -42px 30px; }
}
@keyframes glow-drift-b {
  0%, 100% { translate: 0 0; }
  50%      { translate: 36px -26px; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-grid-layer, .hero-glow-a, .hero-glow-b, .hero-glow-c { animation: none; }
}
.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.hero-left { max-width: 520px; }
.hero-micro {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 500;
  color: rgba(255,255,255,0.28);
  margin: 0 0 20px;
  letter-spacing: 0.03em;
}
.hero-heading {
  font-size: clamp(44px, 5.5vw, 72px);
  font-weight: 800;
  color: #fff;
  margin: 0 0 20px;
  line-height: 1.05;
  letter-spacing: -0.04em;
}
.hero-sub {
  font-size: 18px;
  color: rgba(255,255,255,0.52);
  line-height: 1.68;
  margin: 0 0 36px;
  max-width: 440px;
}
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

/* ─── Section headers ─── */
.section-head { text-align: center; margin-bottom: 52px; }
.section-h2 {
  font-size: clamp(26px, 3.2vw, 40px);
  font-weight: 700;
  margin: 0 0 12px;
  color: var(--ink);
  letter-spacing: -0.035em;
}
.section-sub {
  font-size: 16px;
  color: var(--slate);
  margin: 0 auto;
  max-width: 520px;
  line-height: 1.7;
}

/* ─── Category grid ─── */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

/* ─── E-bikes focus — category lanes ─── */
.ebcat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  align-items: start;
}
.ebcat-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px 22px 16px;
  box-shadow: var(--shadow-sm);
}
.ebcat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 6px;
}
.ebcat-name {
  font-family: 'Sora', sans-serif;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  margin: 0;
  letter-spacing: -0.02em;
}
.ebcat-count {
  flex-shrink: 0;
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.ebcat-desc {
  font-size: 13px;
  color: var(--slate);
  line-height: 1.55;
  margin: 0 0 16px;
}
.ebcat-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ebcat-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 9px 12px;
  border-radius: 11px;
  border: 1px solid var(--line);
  background: var(--paper);
  text-decoration: none;
  transition:
    border-color 0.16s ease,
    background 0.16s ease,
    transform 0.16s var(--ease-spring);
}
.ebcat-item:hover {
  border-color: rgba(34,211,238,0.45);
  background: #fff;
  transform: translateX(2px);
}
.ebcat-item:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 2px;
}
.ebcat-score {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 9px;
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--sc);
  border: 1.5px solid var(--sc);
  background: color-mix(in srgb, var(--sc) 8%, transparent);
}
.ebcat-item-name {
  flex: 1;
  min-width: 0;
  font-family: 'Sora', sans-serif;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ebcat-item-arrow {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 14px;
  opacity: 0;
  transform: translateX(-3px);
  transition: opacity 0.16s ease, transform 0.16s ease, color 0.16s ease;
}
.ebcat-item:hover .ebcat-item-arrow {
  opacity: 1;
  transform: translateX(0);
  color: var(--cyan);
}
.ebcat-cta { text-align: center; margin-top: 32px; }

/* ─── Reviews list ─── */
.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 32px;
}
.list-cta { text-align: center; }

/* ─── Placeholder cards ─── */
.ph-card {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--paper);
  border: 1.5px dashed var(--line);
  border-radius: 16px;
  overflow: hidden;
}
.ph-thumb {
  position: relative;
  width: 96px;
  height: 96px;
  flex-shrink: 0;
  align-self: stretch;
  opacity: 0.5;
}
.ph-body { flex: 1; padding: 14px 16px; }
.ph-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
.ph-category {
  font-size: 10px;
  font-weight: 700;
  font-family: 'Sora', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--muted);
}
.ph-status {
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 600;
  color: var(--muted);
  background: rgba(148,163,184,0.12);
  padding: 1px 7px;
  border-radius: 99px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.ph-name {
  font-family: 'Sora', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: var(--slate);
  margin: 0 0 4px;
  letter-spacing: -0.02em;
}
.ph-focus { font-size: 12px; color: var(--muted); margin: 0; line-height: 1.55; }

/* ─── The Catch ─── */
.catch-section {
  background: var(--ink-deep);
  padding: 96px 0;
  position: relative;
  overflow: hidden;
}
.catch-glow-a {
  position: absolute; top: -20%; right: -5%;
  width: 480px; height: 480px;
  background: radial-gradient(circle, rgba(34,211,238,0.07) 0%, transparent 65%);
  pointer-events: none;
}
.catch-head { text-align: center; margin-bottom: 52px; }
.catch-heading {
  font-size: clamp(28px, 4vw, 52px);
  font-weight: 800;
  color: #fff;
  margin: 0 0 14px;
  letter-spacing: -0.04em;
  line-height: 1.08;
}
.catch-sub {
  font-size: 17px;
  color: rgba(255,255,255,0.42);
  line-height: 1.65;
  max-width: 480px;
  margin: 0 auto;
}
.catch-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.catch-card {
  position: relative;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 18px;
  padding: 28px 24px;
  overflow: hidden;
  transition: border-color 0.18s ease, background 0.18s ease;
}
.catch-card:hover {
  border-color: rgba(34,211,238,0.20);
  background: rgba(255,255,255,0.05);
}
.catch-card-notch {
  position: absolute;
  top: 0; left: 22px;
  width: 3px; height: 22px;
  background: var(--cyan);
  border-radius: 0 0 3px 3px;
  opacity: 0.7;
}
.catch-card-title {
  font-family: 'Sora', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  margin: 0 0 10px;
  letter-spacing: -0.02em;
  line-height: 1.3;
}
.catch-card-body {
  font-size: 14px;
  color: rgba(255,255,255,0.42);
  line-height: 1.65;
  margin: 0;
}

/* ─── Compare ─── */
.compare-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.cmp-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 24px;
  transition: box-shadow 0.15s ease, transform 0.15s var(--ease-spring), border-color 0.15s ease;
}
.cmp-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
  border-color: rgba(34,211,238,0.35);
}
.cmp-vs-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.cmp-side {
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.cmp-vs {
  font-family: 'Sora', sans-serif;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--cyan);
  background: rgba(34,211,238,0.10);
  padding: 3px 8px;
  border-radius: 99px;
}
.cmp-desc { font-size: 13px; color: var(--slate); line-height: 1.55; margin: 0 0 14px; }
.cmp-soon {
  display: inline-block;
  font-family: 'Sora', sans-serif;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 3px 9px;
