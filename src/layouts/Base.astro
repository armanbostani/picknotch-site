---
const { title = 'PickNotch — A notch above the usual picks.', description = 'Independent e-bike and e-mobility reviews and honest deals.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style is:global>
:root{--ink:#1C2540;--cyan:#22D3EE;--paper:#F8FAFC;--slate:#64748B;--line:#E5E9F0;}
*{box-sizing:border-box;}
body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;color:var(--ink);background:#fff;line-height:1.65;}
a{color:inherit;text-decoration:none;}
.wrap{max-width:880px;margin:0 auto;padding:0 22px;}
.site-header{display:flex;align-items:center;justify-content:space-between;max-width:880px;margin:0 auto;padding:16px 22px;border-bottom:1px solid var(--line);}
.brand{display:flex;align-items:center;gap:10px;} .brand b{font-weight:600;font-size:20px;letter-spacing:-0.5px;}
.nav a{color:var(--slate);font-size:15px;margin-left:18px;} .nav a.on{color:var(--ink);}
.hero{padding:42px 0 6px;} .hero h1{font-size:33px;font-weight:600;letter-spacing:-0.6px;margin:0 0 10px;} .hero p{color:var(--slate);font-size:18px;margin:0;}
.card{display:flex;gap:16px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:18px;margin:16px 0;} .card:hover{border-color:#CBD5E1;}
.card h2{margin:0 0 4px;font-size:19px;font-weight:600;} .card .meta{color:var(--slate);font-size:14px;}
.score{flex:none;display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;border:4px solid var(--cyan);font-weight:600;font-size:18px;}
.lead{color:var(--slate);font-size:14px;margin:18px 0 4px;}
h1.title{font-size:30px;font-weight:600;letter-spacing:-0.5px;line-height:1.25;margin:0 0 8px;}
.row{display:flex;gap:18px;flex-wrap:wrap;margin:18px 0;}
.verdict{flex:1.4;min-width:250px;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px 18px;}
.verdict .k{font-size:12px;font-weight:600;color:var(--slate);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;}
.deal{flex:1;min-width:210px;background:var(--ink);color:var(--paper);border-radius:14px;padding:16px 18px;}
.deal .price{font-size:23px;font-weight:600;margin:2px 0 8px;}
.deal .code{display:inline-block;border:1px dashed var(--cyan);color:var(--cyan);border-radius:7px;padding:3px 9px;font-size:13px;letter-spacing:.5px;margin-bottom:10px;}
.deal .cta{display:block;text-align:center;background:var(--cyan);color:#06343B;border-radius:8px;padding:9px;font-weight:600;}
.deal small{display:block;color:#7E8EA3;font-size:11px;margin-top:8px;}
.pc{display:flex;gap:24px;flex-wrap:wrap;margin:8px 0 4px;} .pc>div{flex:1;min-width:220px;}
.pc h3{font-size:14px;font-weight:600;margin:0 0 6px;} .pc .good{color:#0F766E;} .pc .bad{color:#9F1239;}
.pc ul{margin:0;padding-left:18px;color:#334155;font-size:14px;line-height:1.9;}
article p{font-size:16px;color:#334155;}
.disclosure{font-size:12px;color:var(--slate);border-top:1px solid var(--line);margin-top:34px;padding-top:14px;}
.site-footer{background:var(--ink);color:#9FB0C4;margin-top:54px;padding:24px 0;font-size:13px;}
.site-footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;} .site-footer b{color:var(--paper);font-weight:500;}
</style>
</head>
<body>
<header class="site-header">
  <a class="brand" href="/">
    <svg width="34" height="34" viewBox="0 0 80 80" aria-hidden="true"><path d="M20 0 H43 L51 17 L59 0 H60 A20 20 0 0 1 80 20 V60 A20 20 0 0 1 60 80 H20 A20 20 0 0 1 0 60 V20 A20 20 0 0 1 20 0 Z" fill="#1C2540"/><path d="M18 48 L34 64 L62 28" fill="none" stroke="#22D3EE" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/><polyline points="47,28 62,28 62,43" fill="none" stroke="#22D3EE" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <b>PickNotch</b>
  </a>
  <nav class="nav"><a href="/" class={path === '/' ? 'on' : ''}>Reviews</a><a href="/">Deals</a><a href="/">Guides</a><a href="/">About</a></nav>
</header>
<main class="wrap"><slot /></main>
<footer class="site-footer"><div class="wrap"><span><b>PickNotch</b> — a notch above the usual picks.</span><span>Independently researched · affiliate supported</span></div></footer>
</body>
</html>
