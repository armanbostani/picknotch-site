---
import PlaceholderVisual from './PlaceholderVisual.astro';

interface GalleryImage { src: string; alt: string; }
interface Props {
  images: GalleryImage[];
  productName: string;
  category?: string;
  brand?: string;
}
const { images, productName, category, brand } = Astro.props;
const main = images[0];
---

<div class="pg">
  <div class="pg-stage">
    {main ? (
      <img
        id="pg-main"
        class="pg-main-img"
        src={main.src}
        alt={main.alt}
        width="1000"
        height="640"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="pg-placeholder"><PlaceholderVisual label={productName} /></div>
    )}
    <div class="pg-stage-shade" aria-hidden="true"></div>
    {category && (
      <span class="pg-chip">
        <span class="pg-chip-cat">{category}</span>
        {brand && <><span class="pg-chip-sep">·</span><span class="pg-chip-brand">{brand}</span></>}
      </span>
    )}
  </div>

  {images.length > 1 && (
    <div class="pg-thumbs" role="tablist" aria-label={`${productName} gallery`}>
      {images.map((img, i) => (
        <button
          class:list={['pg-thumb', i === 0 ? 'pg-thumb--active' : '']}
          data-src={img.src}
          data-alt={img.alt}
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={img.alt}
        >
          <img src={img.src} alt="" width="120" height="86" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  const gallery = document.querySelector('.pg');
  if (gallery) {
    const main = gallery.querySelector('#pg-main') as HTMLImageElement | null;
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('.pg-thumb');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.src;
        const alt = thumb.dataset.alt ?? '';
        if (!src || !main || main.src.endsWith(src)) return;
        main.style.opacity = '0';
        const swap = () => {
          main.src = src;
          main.alt = alt;
          main.style.opacity = '1';
          main.removeEventListener('transitionend', swap);
        };
        main.addEventListener('transitionend', swap, { once: true });
        // fallback if transitionend doesn't fire
        setTimeout(() => { if (main.style.opacity === '0') swap(); }, 220);
        thumbs.forEach((t) => { t.classList.remove('pg-thumb--active'); t.setAttribute('aria-selected', 'false'); });
        thumb.classList.add('pg-thumb--active');
        thumb.setAttribute('aria-selected', 'true');
      });
    });
  }
</script>

<style>
.pg { display: flex; flex-direction: column; gap: 12px; }

.pg-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 25 / 16;
  border-radius: 20px;
  overflow: hidden;
  background: #EEF1F6;
  box-shadow:
    0 22px 50px rgba(13,21,48,0.16),
    0 6px 16px rgba(13,21,48,0.08),
    inset 0 0 0 1px rgba(13,21,48,0.05);
}
.pg-main-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.2s var(--ease-out);
}
.pg-placeholder { position: absolute; inset: 0; }
.pg-stage-shade {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(13,21,48,0.12) 0%, transparent 22%, transparent 78%, rgba(13,21,48,0.10) 100%);
}

.pg-chip {
  position: absolute;
  top: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(13,21,48,0.62);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 99px;
  padding: 6px 13px;
}
.pg-chip-cat {
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: #5CE6F7;
}
.pg-chip-sep { color: rgba(255,255,255,0.3); font-size: 12px; }
.pg-chip-brand { font-size: 11px; color: rgba(255,255,255,0.7); font-weight: 500; }

.pg-thumbs {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scrollbar-width: none;
  padding: 2px;
  scroll-snap-type: x proximity;
}
.pg-thumbs::-webkit-scrollbar { display: none; }
.pg-thumb {
  flex: 1 1 0;
  min-width: 72px;
  max-width: 116px;
  aspect-ratio: 7 / 5;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid var(--line);
  background: #EEF1F6;
  padding: 0;
  cursor: pointer;
  scroll-snap-align: start;
  transition: border-color 0.16s ease, transform 0.16s var(--ease-spring), box-shadow 0.16s ease;
}
.pg-thumb img { width: 100%; height: 100%; object-fit: cover; }
.pg-thumb:hover { border-color: rgba(34,211,238,0.5); transform: translateY(-2px); }
.pg-thumb:active { transform: translateY(0); }
.pg-thumb:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
.pg-thumb--active {
  border-color: var(--cyan);
  box-shadow: 0 6px 16px rgba(34,211,238,0.22);
}

@media (max-width: 560px) {
  .pg-thumb { flex: 0 0 auto; width: 88px; max-width: none; }
}
</style>
