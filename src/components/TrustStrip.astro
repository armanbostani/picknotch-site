---
const items = [
  {
    label: 'Clear verdicts',
    sub: 'Buy or avoid — no fence-sitting',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <circle cx="8" cy="8" r="7" stroke="#22D3EE" stroke-width="1.5"/>
      <path d="M5 8l2 2 4-4" stroke="#22D3EE" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  },
  {
    label: 'Real trade-offs',
    sub: 'We call out the catch every time',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M8 2L14 13H2L8 2Z" stroke="#22D3EE" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8 6v3M8 11v.5" stroke="#22D3EE" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`,
  },
  {
    label: 'Score breakdowns',
    sub: 'Not just a number — six weighted factors',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <rect x="2" y="9" width="3" height="5" rx="1" fill="#22D3EE" fill-opacity=".5"/>
      <rect x="7" y="5" width="3" height="9" rx="1" fill="#22D3EE" fill-opacity=".75"/>
      <rect x="12" y="2" width="3" height="12" rx="1" fill="#22D3EE"/>
    </svg>`,
  },
  {
    label: 'Affiliate transparent',
    sub: 'Commissions never change the verdict',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <circle cx="8" cy="8" r="6" stroke="#22D3EE" stroke-width="1.5"/>
      <path d="M8 5v1.5M8 9.5V11M6.5 7a1.5 1.5 0 013 0c0 .83-.67 1.5-1.5 1.5H8" stroke="#22D3EE" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`,
  },
];
---

<div class="ts-wrap">
  <div class="wrap">
    <ul class="ts-list">
      {items.map(({ icon, label, sub }) => (
        <li class="ts-item">
          <span class="ts-icon" aria-hidden="true" set:html={icon}></span>
          <div class="ts-text">
            <span class="ts-label">{label}</span>
            <span class="ts-sub">{sub}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
.ts-wrap {
  background: var(--paper);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: 20px 0;
}
.ts-list {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  flex-wrap: wrap;
  list-style: none;
}
.ts-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 28px;
  border-right: 1px solid var(--line);
}
.ts-item:last-child { border-right: none; }
.ts-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: rgba(34,211,238,0.07);
  border-radius: 8px;
}
.ts-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.ts-label {
  font-family: 'Sora', sans-serif;
  font-size: 12px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
  white-space: nowrap;
}
.ts-sub {
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
}
@media (max-width: 900px) {
  .ts-item { padding: 8px 18px; }
  .ts-sub { display: none; }
}
@media (max-width: 640px) {
  .ts-list { gap: 0; justify-content: flex-start; }
  .ts-item { border-right: none; border-bottom: 1px solid var(--line); width: 50%; padding: 12px 16px; }
  .ts-item:nth-child(3), .ts-item:nth-child(4) { border-bottom: none; }
  .ts-sub { display: block; }
}
</style>
