---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="PickNotch home">
        <svg width="24" height="24" viewBox="0 0 80 80" aria-hidden="true">
          <path d="M20 0 H43 L51 17 L59 0 H60 A20 20 0 0 1 80 20 V60 A20 20 0 0 1 60 80 H20 A20 20 0 0 1 0 60 V20 A20 20 0 0 1 20 0 Z" fill="#22D3EE"/>
          <path d="M18 48 L34 64 L62 28" fill="none" stroke="#0D1530" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="47,28 62,28 62,43" fill="none" stroke="#0D1530" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="footer-wordmark">PickNotch</span>
      </a>
      <p class="footer-tagline">A notch above the usual picks.</p>
      <p class="footer-mission">Independent research. Honest trade-offs. Clear verdicts.</p>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/reviews">Reviews</a>
      <a href="/categories">Categories</a>
      <a href="/best">Best Picks</a>
      <a href="/compare">Compare</a>
    </div>

    <div class="footer-col">
      <h4>Trust</h4>
      <a href="/methodology">Methodology</a>
      <a href="/affiliate-disclosure">Affiliate disclosure</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Legal</h4>
      <a href="/privacy">Privacy policy</a>
      <a href="/affiliate-disclosure">Disclosure</a>
    </div>
  </div>

  <div class="footer-bottom wrap">
    <p class="footer-disclosure">PickNotch is independently researched and affiliate supported. We may earn a commission when you buy through our links — at no extra cost to you. Affiliate relationships do not change our verdicts, scores, or the catches we call out.</p>
    <p class="footer-copy">© {year} PickNotch. All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  background: var(--ink-deep);
  color: rgba(255,255,255,0.45);
}
.footer-inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 52px;
  padding-top: 64px;
  padding-bottom: 44px;
}
.footer-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  text-decoration: none;
  transition: opacity 0.13s ease;
  width: fit-content;
}
.footer-logo:hover { opacity: 0.8; }
.footer-logo:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 4px; }
.footer-wordmark {
  font-family: 'Sora', sans-serif;
  font-weight: 800;
  font-size: 17px;
  letter-spacing: -0.04em;
  color: #fff;
}
.footer-tagline {
  font-family: 'Sora', sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.28);
  margin: 0 0 8px;
  letter-spacing: 0.01em;
}
.footer-mission {
  font-size: 13px;
  line-height: 1.65;
  color: rgba(255,255,255,0.28);
  margin: 0;
  max-width: 240px;
}
.footer-col {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.footer-col h4 {
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.11em;
  color: rgba(255,255,255,0.6);
  margin: 0 0 4px;
}
.footer-col a {
  font-size: 13px;
  color: rgba(255,255,255,0.38);
  text-decoration: none;
  transition: color 0.13s ease;
}
.footer-col a:hover { color: rgba(255,255,255,0.75); }
.footer-col a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; border-radius: 2px; }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.06);
  padding-top: 24px;
  padding-bottom: 32px;
}
.footer-disclosure {
  font-size: 11px;
  color: rgba(255,255,255,0.22);
  line-height: 1.7;
  margin: 0 0 8px;
  max-width: 680px;
}
.footer-copy {
  font-size: 11px;
  color: rgba(255,255,255,0.18);
  margin: 0;
}
@media (max-width: 820px) {
  .footer-inner {
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    padding-top: 48px;
  }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 480px) {
  .footer-inner { grid-template-columns: 1fr; gap: 28px; }
}
</style>
