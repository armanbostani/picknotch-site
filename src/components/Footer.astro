---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <svg width="26" height="26" viewBox="0 0 80 80" aria-hidden="true">
          <path d="M20 0 H43 L51 17 L59 0 H60 A20 20 0 0 1 80 20 V60 A20 20 0 0 1 60 80 H20 A20 20 0 0 1 0 60 V20 A20 20 0 0 1 20 0 Z" fill="#22D3EE"/>
          <path d="M18 48 L34 64 L62 28" fill="none" stroke="#1C2540" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="47,28 62,28 62,43" fill="none" stroke="#1C2540" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>PickNotch</span>
      </a>
      <p class="footer-tagline">A notch above the usual picks.</p>
      <p class="footer-mission">We do the boring research, compare the trade-offs, and show you what's actually worth buying.</p>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/reviews">Reviews</a>
      <a href="/categories">Categories</a>
      <a href="/best">Best Picks</a>
      <a href="/compare">Compare</a>
    </div>

    <div class="footer-col">
      <h4>Trust</h4>
      <a href="/methodology">Methodology</a>
      <a href="/affiliate-disclosure">Affiliate Disclosure</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Legal</h4>
      <a href="/privacy">Privacy Policy</a>
      <a href="/affiliate-disclosure">Disclosure</a>
    </div>
  </div>

  <div class="footer-bottom wrap">
    <p class="footer-disclosure">PickNotch is independently researched and affiliate supported. We may earn a commission when you buy through our links, at no extra cost to you. Affiliate relationships do not change our verdicts, scores, or the catches we call out.</p>
    <p class="footer-copy">© {year} PickNotch. All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  background: var(--ink);
  color: #8899B5;
}
.footer-inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  padding-top: 56px;
  padding-bottom: 40px;
}
.footer-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #fff;
  font-family: 'Sora', sans-serif;
  font-weight: 700;
  font-size: 17px;
  letter-spacing: -0.04em;
  margin-bottom: 12px;
  text-decoration: none;
  transition: opacity 0.13s ease;
}
.footer-logo:hover { opacity: 0.85; }
.footer-logo:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 4px; }
.footer-tagline {
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  color: #5A6E8E;
  margin: 0 0 10px;
}
.footer-mission {
  font-size: 13px;
  line-height: 1.65;
  color: #5A6E8E;
  margin: 0;
  max-width: 260px;
}
.footer-col h4 {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: #fff;
  margin: 0 0 14px;
}
.footer-col {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.footer-col a {
  font-size: 14px;
  color: #8899B5;
  text-decoration: none;
  transition: color 0.13s ease;
}
.footer-col a:hover { color: var(--cyan); }
.footer-col a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; border-radius: 2px; }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.07);
  padding-top: 22px;
  padding-bottom: 28px;
}
.footer-disclosure {
  font-size: 12px;
  color: #4A5E7A;
  line-height: 1.65;
  margin: 0 0 8px;
  max-width: 680px;
}
.footer-copy {
  font-size: 12px;
  color: #3A4E6A;
  margin: 0;
}
@media (max-width: 780px) {
  .footer-inner {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding-top: 40px;
  }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 480px) {
  .footer-inner { grid-template-columns: 1fr; }
}
</style>
