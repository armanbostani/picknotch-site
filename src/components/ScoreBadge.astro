---
interface Props {
  score: number | null | undefined;
  size?: 'sm' | 'md' | 'lg';
}
const { score, size = 'md' } = Astro.props;

function scoreColor(s: number) {
  if (s >= 8.5) return '#0D9488';
  if (s >= 7.0) return '#0891B2';
  if (s >= 5.5) return '#D97706';
  return '#DC2626';
}
const color = (score != null) ? scoreColor(score) : '#94A3B8';
const display = (score != null) ? score.toFixed(1) : '—';
---
<div
  class:list={['score-badge', `score-badge--${size}`]}
  style={`--badge-color: ${color}`}
  aria-label={score != null ? `Score: ${score} out of 10` : 'Score not yet available'}
>
  {display}
</div>

<style>
.score-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 3px solid var(--badge-color);
  font-family: 'Sora', sans-serif;
  font-weight: 700;
  color: var(--badge-color);
  flex-shrink: 0;
  line-height: 1;
  background: color-mix(in srgb, var(--badge-color) 6%, transparent);
}
.score-badge--sm  { width: 44px; height: 44px; font-size: 14px; border-width: 2.5px; }
.score-badge--md  { width: 60px; height: 60px; font-size: 18px; }
.score-badge--lg  { width: 80px; height: 80px; font-size: 24px; border-width: 4px; }
</style>
