---
import ScoreBadge from './ScoreBadge.astro';

interface Props {
  title: string;
  brand: string;
  score?: number | null;
  bestFor?: string;
  summary: string;
  slug?: string;
  category?: string;
  status?: string;
}
const { title, brand, score, bestFor, summary, slug, category = 'E-bikes', status } = Astro.props;
const isPublished = status === 'published' || (score != null);
const href = isPublished && slug ? `/reviews/${slug}` : undefined;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['review-card', href ? 'review-card--link' : '']} href={href}>
  <ScoreBadge score={score ?? null} size="md" />
  <div class="rc-body">
    <div class="rc-meta">
      <span class="rc-category">{category}</span>
      {bestFor && <span class="rc-best">Best for: {bestFor}</span>}
    </div>
    <h3 class="rc-title">{title}</h3>
    <p class="rc-summary">{summary}</p>
  </div>
  {href && <span class="rc-arrow" aria-hidden="true">→</span>}
</Tag>

<style>
.review-card {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 20px;
  text-decoration: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
}
.review-card--link { cursor: pointer; }
.review-card--link:hover {
  border-color: #93E6F8;
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.review-card--link:active { transform: translateY(0); }
.review-card--link:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 2px;
  border-radius: 14px;
}
.rc-body { flex: 1; min-width: 0; }
.rc-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
  flex-wrap: wrap;
}
.rc-category {
  font-size: 11px;
  font-weight: 600;
  font-family: 'Sora', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--muted);
}
.rc-best {
  font-size: 12px;
  color: #0E7490;
  background: rgba(34,211,238,0.1);
  padding: 2px 8px;
  border-radius: 20px;
  font-weight: 500;
}
.rc-title {
  font-family: 'Sora', sans-serif;
  font-size: 17px;
  font-weight: 600;
  margin: 0 0 5px;
  line-height: 1.3;
  color: var(--ink);
}
.rc-summary {
  font-size: 14px;
  color: var(--slate);
  margin: 0;
  line-height: 1.55;
}
.rc-arrow {
  flex-shrink: 0;
  font-size: 16px;
  color: var(--cyan);
  opacity: 0;
  transition: opacity 0.15s ease, transform 0.15s ease;
  margin-top: 4px;
}
.review-card--link:hover .rc-arrow { opacity: 1; transform: translateX(2px); }
</style>
