---
import ScoreBadge from './ScoreBadge.astro';
import ProductImage from './ProductImage.astro';

interface Props {
  title: string;
  brand: string;
  score?: number | null;
  bestFor?: string;
  summary: string;
  slug?: string;
  category?: string;
  status?: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
}
const { title, brand, score, summary, slug, category = 'E-bikes', status, image, imageAlt } = Astro.props;
const isPublished = status === 'published' || (score != null);
const href = isPublished && slug ? `/reviews/${slug}` : undefined;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['rc', href ? 'rc--link' : '']} href={href}>
  <div class="rc-thumb">
    <ProductImage src={image} alt={imageAlt ?? brand} fallbackLabel={category} />
  </div>

  <div class="rc-body">
    <span class="rc-category">{category}</span>
    <h3 class="rc-title">{title}</h3>
    <p class="rc-summary">{summary}</p>
  </div>

  <div class="rc-score">
    <ScoreBadge score={score ?? null} size="md" />
    <span class="rc-score-label">Score</span>
  </div>

  {href && (
    <span class="rc-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2.5 7h9M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  )}
</Tag>

<style>
.rc {
  display: flex;
  align-items: stretch;
  gap: 0;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  text-decoration: none;
  min-height: 104px;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s var(--ease-spring);
}
.rc--link { cursor: pointer; }
.rc--link:hover {
  border-color: rgba(34,211,238,0.45);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.rc--link:active { transform: translateY(0); }
.rc--link:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 16px; }

.rc-thumb {
  position: relative;
  width: 108px;
  flex-shrink: 0;
  align-self: stretch;
  background: var(--paper);
}

.rc-body {
  flex: 1;
  min-width: 0;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.rc-category {
  font-size: 10px;
  font-weight: 700;
  font-family: 'Sora', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--muted);
  margin-bottom: 6px;
}
.rc-title {
  font-family: 'Sora', sans-serif;
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 5px;
  line-height: 1.25;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.rc-summary {
  font-size: 13px;
  color: var(--slate);
  line-height: 1.55;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Score rail — sits to the right of the text, never over the photo */
.rc-score {
  flex-shrink: 0;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 22px;
  border-left: 1px solid var(--line);
}
.rc-score-label {
  font-family: 'Sora', sans-serif;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted);
}

.rc-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  color: var(--cyan);
  opacity: 0;
  width: 0;
  transition: opacity 0.18s ease, width 0.18s var(--ease-spring), padding 0.18s ease;
}
.rc--link:hover .rc-arrow { opacity: 1; width: 14px; padding-right: 18px; }

@media (max-width: 520px) {
  .rc { min-height: 92px; }
  .rc-thumb { width: 88px; }
  .rc-body { padding: 13px 14px; }
  .rc-score { padding: 0 14px; }
  .rc-score-label { display: none; }
  .rc-arrow { display: none; }
}
</style>
