---
interface Props {
  pros?: string[];
  cons?: string[];
}
const { pros = [], cons = [] } = Astro.props;
---

<div class="pct">
  {pros.length > 0 && (
    <div class="pct-card pct-card--good">
      <div class="pct-head">
        <span class="pct-head-ic" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="9" fill="rgba(15,118,110,0.12)"/>
            <path d="M5.5 10.2L8.5 13.2L14.5 6.5" stroke="#0F766E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="pct-head-label">What works</span>
      </div>
      <ul class="pct-list">
        {pros.map((p) => (
          <li class="pct-item">
            <svg class="pct-ic pct-ic--good" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7.3L5.5 10.3L11.5 4" stroke="#0F766E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
  {cons.length > 0 && (
    <div class="pct-card pct-card--watch">
      <div class="pct-head">
        <span class="pct-head-ic" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="9" fill="rgba(217,119,6,0.12)"/>
            <path d="M10 5.6v4.6" stroke="#B45309" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="10" cy="13.4" r="1" fill="#B45309"/>
          </svg>
        </span>
        <span class="pct-head-label">What to watch</span>
      </div>
      <ul class="pct-list">
        {cons.map((c) => (
          <li class="pct-item">
            <svg class="pct-ic pct-ic--watch" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 2.2L12.6 11.4H1.4L7 2.2Z" stroke="#B45309" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M7 5.8v2.4" stroke="#B45309" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="7" cy="9.6" r="0.7" fill="#B45309"/>
            </svg>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
.pct {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.pct-card {
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 24px 26px 26px;
  background: #fff;
  box-shadow: 0 4px 18px rgba(13,21,48,0.05);
}
.pct-card--good { background: linear-gradient(180deg, rgba(15,118,110,0.035), #fff 70%); }
.pct-card--watch { background: linear-gradient(180deg, rgba(217,119,6,0.04), #fff 70%); }

.pct-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.pct-head-ic { width: 28px; height: 28px; flex-shrink: 0; }
.pct-head-ic svg { width: 28px; height: 28px; }
.pct-head-label {
  font-family: 'Sora', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--ink);
}

.pct-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
.pct-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 15px;
  line-height: 1.55;
  color: #334155;
}
.pct-ic { width: 14px; height: 14px; flex-shrink: 0; margin-top: 4px; }

@media (max-width: 600px) {
  .pct { grid-template-columns: 1fr; gap: 14px; }
  .pct-card { padding: 20px 20px 22px; }
}
</style>
