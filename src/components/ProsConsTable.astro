---
interface Props {
  pros?: string[];
  cons?: string[];
}
const { pros = [], cons = [] } = Astro.props;
---

<div class="pct">
  {pros.length > 0 && (
    <div class="pct-col pct-pros">
      <div class="pct-header pct-header--good">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="#16A34A" stroke-width="1.5"/>
          <path d="M4.5 8.5L7 11L11.5 6" stroke="#16A34A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>What's good</span>
      </div>
      <ul class="pct-list">
        {pros.map(p => (
          <li class="pct-item">
            <svg class="pct-item-icon pct-item-icon--good" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6.5L4.5 9L10 3" stroke="#16A34A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
  {cons.length > 0 && (
    <div class="pct-col pct-cons">
      <div class="pct-header pct-header--bad">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="#DC2626" stroke-width="1.5"/>
          <line x1="5.5" y1="5.5" x2="10.5" y2="10.5" stroke="#DC2626" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="10.5" y1="5.5" x2="5.5" y2="10.5" stroke="#DC2626" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>What's not</span>
      </div>
      <ul class="pct-list">
        {cons.map(c => (
          <li class="pct-item">
            <svg class="pct-item-icon pct-item-icon--bad" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M6 1.5L10.5 10H1.5L6 1.5Z" stroke="#DC2626" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="6" y1="5" x2="6" y2="7.5" stroke="#DC2626" stroke-width="1.2" stroke-linecap="round"/>
              <circle cx="6" cy="9" r="0.6" fill="#DC2626"/>
            </svg>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
.pct {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 36px;
}

.pct-col {
  border: 1px solid var(--line);
  border-radius: 13px;
  overflow: hidden;
  background: #fff;
}

.pct-header {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 10px 14px 10px;
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  border-bottom: 1px solid var(--line);
}
.pct-header svg { width: 16px; height: 16px; flex-shrink: 0; }
.pct-header--good { background: rgba(22,163,74,0.05); color: #15803D; }
.pct-header--bad  { background: rgba(220,38,38,0.05); color: #B91C1C; }

.pct-list { margin: 0; padding: 4px 0; list-style: none; }

.pct-item {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding: 8px 14px;
  font-size: 13.5px;
  line-height: 1.5;
  color: #334155;
}
.pct-item + .pct-item { border-top: 1px solid var(--line); }

.pct-item-icon {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
  margin-top: 3px;
}

@media (max-width: 560px) {
  .pct { grid-template-columns: 1fr; }
}
</style>
