---
const scoreRows = [
  { label: 'Value for money',        pct: 90 },
  { label: 'Build & spec quality',   pct: 80 },
  { label: 'Real-world usability',   pct: 75 },
  { label: 'Brand & support',        pct: 80 },
  { label: 'Comfort & design',       pct: 65 },
  { label: 'Downsides & risk',       pct: 50, warn: true },
];
---
<section class="method-preview">
  <div class="wrap">
    <div class="method-inner">
      <div class="method-text">
        <p class="method-eyebrow">How we score</p>
        <h2>We don't just rank by specs</h2>
        <p class="method-body">PickNotch looks at value, usability, support confidence, and who the product actually suits. A cheaper product can rank highly if the trade-offs are clear. An expensive product can rank poorly if the value doesn't hold up.</p>
        <a href="/methodology" class="method-link">Read our full methodology →</a>
      </div>

      <div class="method-scores">
        {scoreRows.map(({ label, pct, warn }) => (
          <div class="score-row">
            <span class="score-label">{label}</span>
            <div class="score-bar-track">
              <div
                class:list={['score-bar-fill', warn ? 'fill-warn' : 'fill-default']}
                style={`width: ${pct}%`}
              ></div>
            </div>
            <span class="score-val">{(pct / 10).toFixed(0)}/10</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.method-preview {
  background: var(--ink);
  color: #fff;
  padding: 80px 0;
}
.method-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: center;
}
.method-eyebrow {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--cyan);
  margin: 0 0 12px;
}
.method-text h2 {
  font-size: clamp(22px, 2.8vw, 30px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 14px;
}
.method-body {
  font-size: 15px;
  color: #7A90B0;
  line-height: 1.7;
  margin: 0 0 24px;
}
.method-link {
  font-size: 14px;
  font-weight: 600;
  font-family: 'Sora', sans-serif;
  color: var(--cyan);
  text-decoration: none;
  transition: opacity 0.13s ease;
}
.method-link:hover { opacity: 0.75; }
.method-link:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 2px; }
.method-scores { display: flex; flex-direction: column; gap: 13px; }
.score-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 12px;
  align-items: center;
}
.score-label { font-size: 13px; color: #7A90B0; }
.score-bar-track {
  width: 100px;
  height: 5px;
  background: rgba(255,255,255,0.09);
  border-radius: 99px;
  overflow: hidden;
}
.score-bar-fill {
  height: 100%;
  border-radius: 99px;
}
.fill-default { background: var(--cyan); }
.fill-warn    { background: #F59E0B; }
.score-val {
  font-family: 'Sora', sans-serif;
  font-size: 12px;
  font-weight: 600;
  color: #C0CEDF;
  min-width: 30px;
  text-align: right;
}
@media (max-width: 780px) {
  .method-inner { grid-template-columns: 1fr; gap: 40px; }
  .score-bar-track { width: 80px; }
}
</style>
