---
const factors = [
  { label: 'Value for money',     pct: 90, icon: '◈' },
  { label: 'Build & spec quality',pct: 80, icon: '◈' },
  { label: 'Real-world usability',pct: 75, icon: '◈' },
  { label: 'Brand & support',     pct: 80, icon: '◈' },
  { label: 'Comfort & design',    pct: 65, icon: '◈' },
  { label: 'Downsides & risk',    pct: 50, icon: '◈', warn: true },
];

const overallScore = 8.6;
const r = 34;
const circ = 2 * Math.PI * r;
const offset = circ * (1 - overallScore / 10);
---

<section class="mp-section">
  <div class="wrap">
    <div class="mp-inner">

      <!-- Left: copy + CTA -->
      <div class="mp-text">
        <p class="mp-eyebrow">Methodology</p>
        <h2 class="mp-heading">We score what actually changes the buying decision.</h2>
        <p class="mp-body">A cheaper product can rank highly when the trade-offs are right. An expensive product can rank poorly when the value doesn't hold. Six weighted factors. No fake perfect scores.</p>

        <div class="mp-factors-mobile">
          {factors.map(({ label, pct, warn }) => (
            <div class="mpf-row">
              <span class="mpf-label">{label}</span>
              <div class="mpf-track">
                <div class:list={['mpf-fill', warn ? 'mpf-fill--warn' : '']} style={`width: ${pct}%`}></div>
              </div>
              <span class="mpf-val">{(pct / 10).toFixed(0)}</span>
            </div>
          ))}
        </div>

        <a href="/methodology" class="mp-link">
          Read our full methodology
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Right: visual dashboard -->
      <div class="mp-dashboard">
        <!-- Score ring -->
        <div class="mp-ring-block">
          <div class="mp-ring-wrap">
            <svg class="mp-ring-svg" viewBox="0 0 80 80">
              <defs>
                <linearGradient id="mp-ring-grad" x1="1" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#22D3EE"/>
                  <stop offset="100%" stop-color="#0891B2"/>
                </linearGradient>
              </defs>
              <circle cx="40" cy="40" r={r} fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="5"/>
              <circle cx="40" cy="40" r={r}
                fill="none"
                stroke="url(#mp-ring-grad)"
                stroke-width="5"
                stroke-linecap="round"
                stroke-dasharray={circ}
                stroke-dashoffset={offset}
                transform="rotate(-90 40 40)"
              />
            </svg>
            <div class="mp-ring-center">
              <span class="mp-ring-num">{overallScore}</span>
              <span class="mp-ring-sub">/10</span>
            </div>
          </div>
          <p class="mp-ring-label">Example score</p>
        </div>

        <!-- Factor bars -->
        <div class="mp-factors">
          {factors.map(({ label, pct, warn }) => (
            <div class="mpf-row">
              <span class="mpf-label">{label}</span>
              <div class="mpf-track">
                <div class:list={['mpf-fill', warn ? 'mpf-fill--warn' : '']} style={`width: ${pct}%`}></div>
              </div>
              <span class="mpf-val">{(pct / 10).toFixed(0)}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.mp-section {
  background: var(--ink-deep);
  padding: 96px 0;
}
.mp-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.mp-eyebrow {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--cyan);
  margin: 0 0 14px;
}
.mp-heading {
  font-size: clamp(22px, 2.8vw, 32px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 16px;
  line-height: 1.2;
}
.mp-body {
  font-size: 15px;
  color: rgba(255,255,255,0.45);
  line-height: 1.72;
  margin: 0 0 28px;
}
.mp-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--cyan);
  text-decoration: none;
  transition: opacity 0.13s ease, transform 0.13s ease;
}
.mp-link:hover { opacity: 0.75; transform: translateX(3px); }
.mp-link:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 2px; }

/* Dashboard */
.mp-dashboard {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 20px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* Score ring block */
.mp-ring-block {
  display: flex;
  align-items: center;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.mp-ring-wrap {
  position: relative;
  width: 72px;
  height: 72px;
  flex-shrink: 0;
}
.mp-ring-svg { width: 72px; height: 72px; display: block; }
.mp-ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  line-height: 1;
}
.mp-ring-num {
  font-family: 'Sora', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.05em;
}
.mp-ring-sub {
  font-family: 'Sora', sans-serif;
  font-size: 9px;
  font-weight: 600;
  color: rgba(255,255,255,0.4);
}
.mp-ring-label {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 600;
  color: rgba(255,255,255,0.4);
  margin: 0;
}

/* Factor rows */
.mp-factors { display: flex; flex-direction: column; gap: 11px; }
.mp-factors-mobile { display: none; flex-direction: column; gap: 10px; margin-bottom: 24px; }
.mpf-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 10px;
  align-items: center;
}
.mpf-label {
  font-size: 12px;
  color: rgba(255,255,255,0.5);
}
.mpf-track {
  width: 90px;
  height: 4px;
  background: rgba(255,255,255,0.07);
  border-radius: 99px;
  overflow: hidden;
}
.mpf-fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, #22D3EE, #0891B2);
}
.mpf-fill--warn { background: linear-gradient(90deg, #F59E0B, #D97706); }
.mpf-val {
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 700;
  color: rgba(255,255,255,0.55);
  min-width: 18px;
  text-align: right;
}

@media (max-width: 820px) {
  .mp-inner { grid-template-columns: 1fr; gap: 40px; }
  .mp-dashboard { display: none; }
  .mp-factors-mobile { display: flex; }
  .mpf-track { width: 70px; }
  .mp-section { padding: 64px 0; }
}
</style>
