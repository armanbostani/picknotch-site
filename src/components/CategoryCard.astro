---
import PlaceholderVisual from './PlaceholderVisual.astro';

interface Props {
  name: string;
  description: string;
  status: 'active' | 'coming-soon';
  icon: string;
  href?: string;
  tint?: 'default' | 'warm' | 'forest' | 'slate';
}
const { name, description, status, icon, href, tint = 'default' } = Astro.props;
const active = status === 'active';
const Tag = active && href ? 'a' : 'div';
---

<Tag
  class:list={['cc-card', active ? 'cc-card--active' : 'cc-card--soon']}
  href={active && href ? href : undefined}
>
  <!-- Visual top area -->
  <div class="cc-visual">
    <PlaceholderVisual tint={tint} />
    <span class="cc-icon" aria-hidden="true">{icon}</span>
    <span class:list={['cc-pill', active ? 'cc-pill--active' : 'cc-pill--soon']}>
      {active ? 'Active' : 'Coming soon'}
    </span>
  </div>

  <!-- Content -->
  <div class="cc-body">
    <div class="cc-head">
      <h3 class="cc-name">{name}</h3>
      {active && href && (
        <svg class="cc-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      )}
    </div>
    <p class="cc-desc">{description}</p>
  </div>
</Tag>

<style>
.cc-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
  text-decoration: none;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s var(--ease-spring);
}
.cc-card--active {
  cursor: pointer;
}
.cc-card--active:hover {
  border-color: rgba(34,211,238,0.5);
  box-shadow: 0 6px 28px rgba(34,211,238,0.10), var(--shadow-md);
  transform: translateY(-3px);
}
.cc-card--active:active { transform: translateY(0); }
.cc-card--active:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 18px; }
.cc-card--soon { opacity: 0.55; }

/* Visual area */
.cc-visual {
  position: relative;
  height: 110px;
  overflow: hidden;
}
.cc-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -56%);
  font-size: 28px;
  line-height: 1;
  filter: drop-shadow(0 2px 6px rgba(0,0,0,0.3));
}
.cc-pill {
  position: absolute;
  top: 10px;
  right: 10px;
  font-family: 'Sora', sans-serif;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  padding: 3px 9px;
  border-radius: 99px;
}
.cc-pill--active {
  background: rgba(34,211,238,0.18);
  color: #22D3EE;
  border: 1px solid rgba(34,211,238,0.30);
}
.cc-pill--soon {
  background: rgba(148,163,184,0.15);
  color: rgba(148,163,184,0.9);
  border: 1px solid rgba(148,163,184,0.25);
}

/* Content */
.cc-body {
  padding: 14px 16px 16px;
  flex: 1;
}
.cc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.cc-name {
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.cc-arrow {
  color: var(--cyan);
  flex-shrink: 0;
  opacity: 0;
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.cc-card--active:hover .cc-arrow { opacity: 1; transform: translateX(3px); }
.cc-desc {
  font-size: 12px;
  color: var(--slate);
  line-height: 1.55;
}
</style>
