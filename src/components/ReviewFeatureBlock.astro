---
interface Props {
  label?: string;
  title: string;
  body: string;
  take?: string;
  image: string;
  imageAlt: string;
  fit?: 'cover' | 'contain';
  position?: string;
  reverse?: boolean;
}
const { label, title, body, take, image, imageAlt, fit = 'cover', position = 'center', reverse = false } = Astro.props;
---

<div class:list={['fb', reverse ? 'fb--reverse' : '']} data-reveal>
  <div class="fb-media">
    <img src={image} alt={imageAlt} loading="lazy" decoding="async" width="900" height="675" style={`object-fit:${fit};object-position:${position}`} />
    <div class="fb-media-tint" aria-hidden="true"></div>
  </div>
  <div class="fb-text">
    {label && <span class="fb-label">{label}</span>}
    <h3 class="fb-title">{title}</h3>
    <p class="fb-body">{body}</p>
    {take && (
      <div class="fb-take">
        <span class="fb-take-label">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1l1.4 2.9 3.1.45-2.25 2.2.53 3.1L6 8.2 3.2 9.65l.53-3.1L1.5 4.35l3.1-.45L6 1z" fill="currentColor"/></svg>
          PickNotch take
        </span>
        <p class="fb-take-text">{take}</p>
      </div>
    )}
  </div>
</div>

<style>
.fb {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 52px;
  align-items: center;
}
.fb--reverse .fb-media { order: 2; }

.fb-media {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background: #eef2f7;
  box-shadow: 0 24px 50px rgba(13,21,48,0.16), 0 6px 14px rgba(13,21,48,0.08);
}
.fb-media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.7s var(--ease-out);
}
.fb:hover .fb-media img { transform: scale(1.04); }
.fb-media-tint {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, transparent 58%, rgba(13,21,48,0.18) 100%),
    radial-gradient(120% 90% at 82% 8%, rgba(34,211,238,0.12), transparent 55%);
}

.fb-text { padding: 6px 0; }
.fb-label {
  display: inline-block;
  font-family: 'Sora', sans-serif;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--cyan);
  margin-bottom: 14px;
  padding-left: 30px;
  position: relative;
}
.fb-label::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  width: 22px; height: 2px;
  background: var(--cyan);
  transform: translateY(-50%);
}
.fb-title {
  font-size: clamp(22px, 2.4vw, 29px);
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--ink);
  margin-bottom: 12px;
  line-height: 1.14;
}
.fb-body {
  font-size: 16px;
  line-height: 1.68;
  color: var(--slate);
  max-width: 44ch;
}
.fb-take {
  margin-top: 18px;
  padding: 14px 18px;
  border-left: 3px solid var(--cyan);
  background: linear-gradient(90deg, rgba(34,211,238,0.07), rgba(34,211,238,0.0));
  border-radius: 0 12px 12px 0;
}
.fb-take-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'Sora', sans-serif;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #0E7490;
  margin-bottom: 6px;
}
.fb-take-text { font-size: 14px; line-height: 1.6; color: #334155; margin: 0; }

@media (max-width: 760px) {
  .fb { grid-template-columns: 1fr; gap: 22px; }
  .fb--reverse .fb-media { order: 0; }
  .fb-body { max-width: none; }
}
</style>
