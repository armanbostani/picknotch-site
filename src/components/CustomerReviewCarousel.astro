---
interface Review {
  name: string;
  rating: number;
  title: string;
  body: string;
  avatar?: string;
  source?: string;
}

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;

function initials(name: string): string {
  const clean = name.replace(/^@/, '').trim();
  const parts = clean.split(/\s+/);
  return parts.slice(0, 2).map(p => p[0]?.toUpperCase() ?? '').join('');
}

const gradients = [
  ['#0A3D55', '#22D3EE'],
  ['#1A2442', '#0891B2'],
  ['#0D2040', '#38BDF8'],
  ['#0F2F24', '#22D3EE'],
];

const cardWidth = 300;
const cardGap = 24;
const totalPx = reviews.length * (cardWidth + cardGap);
const duration = Math.max(reviews.length * 8, 20);

const doubled = [...reviews, ...reviews];
---

{reviews.length > 0 && (
  <div class="crc-outer" role="region" aria-label="Customer reviews">
    <div
      class="crc-track"
      style={`--move-to: -${totalPx}px; animation-duration: ${duration}s`}
    >
      {doubled.map((r, i) => {
        const inits = initials(r.name);
        const grad = gradients[i % gradients.length];
        const isDupe = i >= reviews.length;
        return (
          <div class="crc-card" aria-hidden={isDupe ? 'true' : undefined}>
            <div class="crc-top">
              <div class="crc-avatar">
                {r.avatar ? (
                  <img src={r.avatar} alt={r.name} class="crc-avatar-img" loading="lazy" />
                ) : (
                  <div class="crc-avatar-fallback" style={`background: linear-gradient(135deg, ${grad[0]}, ${grad[1]})`}>
                    <span class="crc-initials">{inits}</span>
                  </div>
                )}
              </div>
              <div class="crc-nameblock">
                <span class="crc-name">{r.name}</span>
                {r.source && <span class="crc-source">{r.source}</span>}
              </div>
            </div>

            <div class="crc-stars" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, si) => (
                <svg class:list={['crc-star', si < r.rating ? 'crc-star--filled' : 'crc-star--empty']} viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 1.5l1.545 3.131L13 5.19l-2.5 2.435.59 3.439L8 9.385l-3.09 1.68.59-3.44L3 5.19l3.455-.559L8 1.5z" stroke-width="1" stroke-linejoin="round"/>
                </svg>
              ))}
            </div>

            <p class="crc-title">{r.title}</p>
            <p class="crc-body">&ldquo;{r.body}&rdquo;</p>
          </div>
        );
      })}
    </div>
  </div>
)}

<style>
.crc-outer {
  overflow: hidden;
  position: relative;
  -webkit-mask: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  mask: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  padding: 4px 0 8px;
}

.crc-track {
  display: flex;
  align-items: stretch;
  animation: crc-scroll linear infinite;
  width: max-content;
}

.crc-track:hover {
  animation-play-state: paused;
}

@keyframes crc-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(var(--move-to)); }
}

@media (prefers-reduced-motion: reduce) {
  .crc-track {
    animation: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    -webkit-mask: none;
    mask: none;
  }
  .crc-card { scroll-snap-align: start; }
}

.crc-card {
  flex-shrink: 0;
  width: 300px;
  margin-right: 24px;
  background: #fff;
  border: 1px solid rgba(26,36,66,0.08);
  border-radius: 20px;
  padding: 24px 22px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow:
    0 2px 12px rgba(26,36,66,0.06),
    0 1px 4px rgba(26,36,66,0.04);
  transition: box-shadow 0.18s ease, transform 0.18s var(--ease-spring, cubic-bezier(0.22,1,0.36,1));
}

.crc-card:hover {
  box-shadow:
    0 8px 28px rgba(26,36,66,0.10),
    0 2px 8px rgba(26,36,66,0.06);
  transform: translateY(-2px);
}

.crc-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.crc-avatar {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  overflow: hidden;
  border: 1.5px solid rgba(34,211,238,0.3);
}

.crc-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.crc-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.crc-initials {
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: rgba(255,255,255,0.92);
  letter-spacing: -0.01em;
  line-height: 1;
}

.crc-nameblock {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.crc-name {
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #1A2442;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: -0.01em;
}

.crc-source {
  font-size: 11px;
  color: #94A3B8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.crc-stars {
  display: flex;
  gap: 3px;
  align-items: center;
}

.crc-star {
  width: 15px;
  height: 15px;
}

.crc-star--filled {
  fill: #F59E0B;
  stroke: #F59E0B;
}

.crc-star--empty {
  fill: none;
  stroke: #CBD5E1;
}

.crc-title {
  font-family: 'Sora', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: #1A2442;
  margin: 0;
  line-height: 1.3;
  letter-spacing: -0.015em;
}

.crc-body {
  font-size: 13px;
  color: #475569;
  line-height: 1.68;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-style: italic;
}
</style>
