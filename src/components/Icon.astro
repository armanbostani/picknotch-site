---
type IconName = 'ebike' | 'tech' | 'home' | 'outdoor' | 'tools' | 'budget' | 'fold' | 'city';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: cls, size = 24 } = Astro.props;
---

{name === 'ebike' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="5.5" cy="17" r="3.5"/>
    <circle cx="18.5" cy="17" r="3.5"/>
    <path d="M5.5 17L9 8h5l2 4"/>
    <path d="M9 8H7"/>
    <path d="M14 12l4.5 5"/>
    <path d="M15 8h3"/>
    <circle cx="17" cy="8" r="0.5" fill="currentColor"/>
  </svg>
)}

{name === 'tech' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2" y="4" width="20" height="13" rx="2"/>
    <path d="M8 21h8M12 17v4"/>
  </svg>
)}

{name === 'home' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 12L12 3l9 9"/>
    <path d="M9 21V12h6v9"/>
    <path d="M5 10.5V21h14V10.5"/>
  </svg>
)}

{name === 'outdoor' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 20l7-13 4 7 3-5 6 11H2z"/>
    <circle cx="19" cy="6" r="2"/>
  </svg>
)}

{name === 'tools' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
  </svg>
)}

{name === 'budget' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"/>
    <path d="M12 6v2M12 16v2M9 9.5h4.5a1.5 1.5 0 010 3H10a1.5 1.5 0 000 3H15"/>
  </svg>
)}

{name === 'fold' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="4" y="2" width="16" height="20" rx="2"/>
    <path d="M12 2v12"/>
    <path d="M8 9l4 5 4-5"/>
  </svg>
)}

{name === 'city' && (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="9" width="7" height="13"/>
    <rect x="14" y="5" width="7" height="17"/>
    <path d="M10 22h4"/>
    <path d="M6 13h1M6 17h1M17 9h1M17 13h1M17 17h1"/>
  </svg>
)}

<style>
.icon { display: block; flex-shrink: 0; }
</style>
